---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteNav from '../../components/SiteNav.astro';
import cv from '../../../content/cv.json';
import site from '../../../content/site.json';

const flagged = cv.sections.flatMap((section) =>
  section.entries
    .filter((entry) => 'flag' in entry && entry.flag)
    .map((entry) => ({
      section: section.heading,
      title: entry.title,
      flag: entry.flag,
    })),
);
---

<BaseLayout title={cv.title} description={cv.description}>
  <SiteNav />
  <div class="page wrap page--cv">
    <header class="page-head">
      <h1>{cv.fullName}</h1>
      <p class="hero__role">{cv.tagline}</p>
      <p class="hero__students">{cv.quote}</p>
    </header>

    <section class="cv-intro" aria-label="Summary">
      {cv.intro.map((paragraph) => <p>{paragraph}</p>)}
      <p class="cv-source">
        Sourced from the
        <a href={cv.sourceHref} rel="noopener noreferrer">{cv.sourceLabel}</a>.
        {cv.presentNote}
      </p>
      {cv.introFlag && <p class="cv-flag"><span class="cv-flag__label">Flagged</span> {cv.introFlag}</p>}
    </section>

    <section class="cv-review" aria-labelledby="cv-flags">
      <h2 class="kicker" id="cv-flags">Flagged for review</h2>
      <p class="writing__note">Printed as on the public CV, except the present title. Nothing here was silently corrected.</p>
      <ol class="cv-review__list">
        <li>
          <p class="cv-entry__title">Intro</p>
          <p class="cv-flag">{cv.introFlag}</p>
        </li>
        {
          flagged.map((item) => (
            <li>
              <p class="cv-entry__title">
                {item.section}: {item.title}
              </p>
              <p class="cv-flag">{item.flag}</p>
            </li>
          ))
        }
      </ol>
    </section>

    {
      cv.sections.map((section, index) => (
        <section class="cv-section" aria-labelledby={`cv-section-${index}`}>
          <h2 class="kicker" id={`cv-section-${index}`}>
            {section.heading}
          </h2>
          <ul class="cv-list">
            {section.entries.map((entry) => (
              <li class:list={['cv-entry', { 'cv-entry--flagged': 'flag' in entry && entry.flag }]}>
                <p class="cv-entry__when">{entry.when}</p>
                <div>
                  <p class="cv-entry__title">{entry.title}</p>
                  {entry.detail && <p class="cv-entry__detail">{entry.detail}</p>}
                  {'flag' in entry && entry.flag && (
                    <p class="cv-flag">
                      <span class="cv-flag__label">Flagged</span> {entry.flag}
                    </p>
                  )}
                </div>
              </li>
            ))}
          </ul>
        </section>
      ))
    }

    <footer class="site-footer">
      <p>{site.name}</p>
    </footer>
  </div>
</BaseLayout>
